{
  "name": "html-figma",
  "version": "0.3.1",
  "description": "Convert DOM node to Figma Node",
  "repository": {
    "type": "git",
    "url": "https://github.com/sergcen/html-to-figma"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "npm run build:tests && esbuild tests/page/index.ts --bundle --outfile=dist/index.js --watch --servedir=dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "publish:package": "npm run build:package && cd build && npm publish",
    "build:package": "tsc -p tsconfig.json && node scripts/prepare-publish.mjs",
    "build:tests": "esbuild tests/page/index.ts --bundle --outfile=dist/index.js && node scripts/copy-stubs.mjs",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "npm run build:tests && jest --selectProjects e2e",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "author": "Sergei Savelev",
  "license": "MIT",
  "devDependencies": {
    "@figma/plugin-typings": "1.19.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-puppeteer": "^11.0.0",
    "puppeteer": "24.43.1",
    "serve": "^14.2.4",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "prettier": {
    "tabWidth": 4,
    "singleQuote": true
  },
  "dependencies": {
    "file-type": "^12.2.0"
  }
}
